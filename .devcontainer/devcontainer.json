{
  "name": "Trading Bot – Headless",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt",
  "containerEnv": {
    "TRADING_LOG_DIR": "/workspaces/pasta-gemini-trade/logs"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylint"
      ]
    }
  }
}
